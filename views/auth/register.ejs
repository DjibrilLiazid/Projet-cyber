<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card auth-card">
      <div class="card-body p-4">
        <h2 class="card-title mb-1">Créer un compte</h2>
        <p class="text-muted mb-4">Rejoignez SecureShop</p>

        <form action="/auth/register" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="username" class="form-label">Pseudo</label>
            <input type="text" class="form-control" id="username" name="username"
                   required minlength="3" maxlength="50"
                   pattern="[a-zA-Z0-9_]+"
                   placeholder="monpseudo_42">
            <div class="form-text">Lettres, chiffres et _ uniquement (3–50 caractères)</div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email"
                   required placeholder="vous@exemple.fr">
          </div>

          <div class="mb-3">
            <label for="password" class="form-label">Mot de passe</label>
            <input type="password" class="form-control" id="password" name="password"
                   required minlength="8" placeholder="••••••••">
            <div class="form-text">8+ caractères, 1 majuscule, 1 chiffre, 1 caractère spécial</div>
          </div>

          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirmer le mot de passe</label>
            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                   required placeholder="••••••••">
          </div>

          <button type="submit" class="btn btn-primary w-100">Créer mon compte</button>
        </form>

        <hr class="my-4">
        <p class="text-center mb-0">
          Déjà un compte ? <a href="/auth/login">Se connecter</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
