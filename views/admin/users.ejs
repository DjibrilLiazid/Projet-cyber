<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="page-title">👥 Gestion Utilisateurs</h1>
  <a href="/admin" class="btn btn-outline-secondary">← Dashboard</a>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>ID</th><th>Pseudo</th><th>Email</th><th>Rôle</th>
          <th>Tentatives</th><th>Statut</th><th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr class="<%= !u.is_active ? 'table-secondary' : '' %>">
            <td><%= u.id %></td>
            <td><strong><%= u.username %></strong></td>
            <td><%= u.email %></td>
            <td>
              <span class="badge bg-<%= u.role === 'admin' ? 'warning text-dark' : 'secondary' %>">
                <%= u.role %>
              </span>
            </td>
            <td>
              <% if (u.failed_login_attempts > 0) { %>
                <span class="text-danger"><%= u.failed_login_attempts %> ⚠️</span>
              <% } else { %>
                <span class="text-muted">0</span>
              <% } %>
            </td>
            <td>
              <% if (u.is_active) { %>
                <span class="badge bg-success">Actif</span>
              <% } else { %>
                <span class="badge bg-danger">Désactivé</span>
              <% } %>
            </td>
            <td>
              <% if (u.role !== 'admin' && u.id !== currentUser.id) { %>
                <form action="/admin/users/<%= u.id %>/toggle" method="POST" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-<%= u.is_active ? 'outline-danger' : 'outline-success' %>">
                    <%= u.is_active ? 'Désactiver' : 'Activer' %>
                  </button>
                </form>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
