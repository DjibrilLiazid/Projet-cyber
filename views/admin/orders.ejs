<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="page-title">🛒 Toutes les commandes</h1>
  <a href="/admin" class="btn btn-outline-secondary">← Dashboard</a>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>#</th><th>Client</th><th>Email</th><th>Total</th><th>Statut</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><strong><%= o.username %></strong></td>
            <td><%= o.email %></td>
            <td><%= parseFloat(o.total).toFixed(2) %> €</td>
            <td>
              <span class="badge bg-<%= o.status === 'paid' ? 'success' : o.status === 'shipped' ? 'info' : o.status === 'cancelled' ? 'danger' : 'warning text-dark' %>">
                <%= o.status %>
              </span>
            </td>
            <td><%= new Date(o.created_at).toLocaleDateString('fr-FR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
