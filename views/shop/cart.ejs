<%- include('../partials/header') %>

<h1 class="page-title mb-4">🛒 Mon Panier</h1>

<% if (items.length === 0) { %>
  <div class="text-center py-5">
    <div style="font-size: 4rem">🛒</div>
    <p class="text-muted mt-3">Votre panier est vide.</p>
    <a href="/shop" class="btn btn-primary">Voir le catalogue</a>
  </div>
<% } else { %>
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <% items.forEach((item, index) => { %>
            <div class="cart-item d-flex align-items-center gap-3 py-3">
              <div class="cart-item-emoji">
                <% if (item.name.includes('Casque') || item.name.includes('Audio')) { %>🎧
                <% } else if (item.name.includes('Souris') || item.name.includes('Clavier') || item.name.includes('Tapis')) { %>🖱️
                <% } else if (item.name.includes('Webcam')) { %>📹
                <% } else if (item.name.includes('SSD')) { %>💾
                <% } else { %>📦<% } %>
              </div>
              <div class="flex-grow-1">
                <h6 class="mb-0"><%= item.name %></h6>
                <small class="text-muted"><%= item.price.toFixed(2) %> € × <%= item.quantity %></small>
              </div>
              <div class="fw-bold"><%= (item.price * item.quantity).toFixed(2) %> €</div>
              <form action="/shop/cart/remove" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="item_id" value="<%= item.id %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
              </form>
            </div>
            <% if (index !== items.length - 1) { %><hr class="my-0"><% } %>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card cart-summary">
        <div class="card-body">
          <h5 class="card-title">Récapitulatif</h5>
          <div class="d-flex justify-content-between mb-2">
            <span>Sous-total</span><span><%= total %> €</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Livraison</span><span class="text-success">Gratuite</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Total</span><span><%= total %> €</span>
          </div>

          <form action="/shop/checkout" method="POST" class="mt-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-primary w-100 btn-lg">
              ✅ Commander
            </button>
          </form>

          <a href="/shop" class="btn btn-outline-secondary w-100 mt-2">
            Continuer les achats
          </a>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
